# ============================================================
# python-checkin 环境变量模板
# 用法：复制为 .env 后填写真实值
#   cp .env.example .env
# 说明：docker compose 会自动读取同目录 .env 注入容器；
#       本地直接跑 uvicorn 时 app 进程也会读 .env。
# ============================================================

# ---- 数据库（compose 用；本地跑用 DATABASE_URL）----
POSTGRES_PASSWORD=postgres

# 本地直跑（非 Docker）时用的连接串
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/python_checkin

# ---- 认证 ----
# 生产务必换成随机长字符串：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
# 定时任务密钥（/api/agent/cron/daily）：留空则不校验（本地调试）；生产务必设置
# 调度器请求时带 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# 对外访问地址（域名或 IP，nginx 入口）
PUBLIC_BASE_URL=http://localhost
# nginx 对外端口
HTTP_PORT=80

# ---- AI 模型池（OpenAI 兼容，多家自动降级）----
# ① 阿里云百炼 DashScope（推荐）：一个 key 通吃 qwen 对话 + 向量 embedding，
#    新用户有免费额度。申请：https://bailian.console.aliyun.com/ 控制台拿 API-KEY
ALIYUN_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v2

# ② Agnes 聚合平台（原项目作者的中转站，可选）。
#    没有账号可留空，模型池会自动跳过未配置的 provider。
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ---- 用量限额 ----
# 每个用户每天最多消耗的 token（0 = 不限）。默认 20 万。
AI_TOKEN_LIMIT=200000

# ---- OSS 阿里云对象存储（头像/壁纸直传，不配则上传类功能不可用）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-guangzhou
# OSS bucket 的公开访问地址（形如 https://your-bucket.oss-cn-guangzhou.aliyuncs.com）
OSS_PUBLIC_BASE_URL=
